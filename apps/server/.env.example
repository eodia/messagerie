# Chat server — every variable is optional in development.
# CHAT_PORT=8810
# DATABASE_URL=postgres://chat:chat@127.0.0.1:55440/chat
# CHAT_WEB_ORIGIN=http://localhost:3210
# Signs the visitors' tokens. Required in production, 32 characters at least:
#   openssl rand -base64 32
# CHAT_SECRET=
# 1 behind a reverse proxy: the visitor's address is read from X-Forwarded-For.
# CHAT_TRUST_PROXY=1
# Where the files sent in conversations are kept (10 Mo each at most).
# CHAT_FILES_DIR=.files

# The AI (docs/architecture/00-decisions-structurantes.md, D7, D9). Without a key, no AI:
# every conversation goes to the agents.
# CHAT_AI_PROVIDER=mistral            # or openai, ollama
# CHAT_AI_BASE_URL=                   # any OpenAI-compatible server
# CHAT_AI_MODEL=mistral-small-latest
# CHAT_AI_EMBEDDING_MODEL=mistral-embed
# CHAT_AI_API_KEY=
# CHAT_AI_REDACT=0                    # send personal data as it is (masked by default)
# CHAT_AI_MIN_SIMILARITY=0.7          # below, a passage is not a source
# separate: the AI's jobs run in `pnpm worker`, not in the server.
# CHAT_WORKER=separate

# Secrets the AI's tools and MCP servers name in basedb as ${NAME} — never their values
# (D5). The demonstration needs none.
# METEO_TOKEN=

# basedb 0.5.0 or later (docs/architecture/00-decisions-structurantes.md, D2 to D4).
# In development, `corepack pnpm db:up && corepack pnpm basedb:setup` runs the chat's own
# basedb in docker and writes these four, and CHAT_DEV_AGENT, here.
# BASEDB_API_URL=http://localhost:8787
# BASEDB_TENANT=t4z56fq
# The « Messagerie » base, as `pnpm provision` names it, and an integration token of that
# base. Give it write access: promoting a conversation creates a row in « Conversations
# promues ». (The widget editor writes with the supervisor's own token, not this one.)
# BASEDB_BASE=b_t4z56fq_messagerie
# BASEDB_TOKEN=bdb_…
# The basedb group that may edit that base: a supervisor invited or named in the inbox
# joins it (`pnpm basedb:setup` creates « Superviseurs de la messagerie »).
# BASEDB_SUPERVISORS_GROUP=

# `pnpm provision` only: an administrator of basedb, by token or by e-mail and password.
# BASEDB_ADMIN_TOKEN=bda_…
# BASEDB_ADMIN_EMAIL=
# BASEDB_ADMIN_PASSWORD=

# Development only: requests without a token are made as this basedb user. `dev-marc` is
# seeded by `pnpm seed`.
CHAT_DEV_AGENT=dev-marc
