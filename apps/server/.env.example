# Chat server — every variable is optional in development.
# CHAT_PORT=8810
# DATABASE_URL=postgres://chat:chat@127.0.0.1:55440/chat
# CHAT_WEB_ORIGIN=http://localhost:3210

# Development only: every request is made as this basedb user, until basedb can vouch for
# an identity (docs/architecture/00-decisions-structurantes.md, B2). `dev-marc` is seeded.
CHAT_DEV_AGENT=dev-marc
