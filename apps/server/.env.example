# Chat server — every variable is optional in development.
# CHAT_PORT=8810
# DATABASE_URL=postgres://chat:chat@127.0.0.1:55440/chat
# CHAT_WEB_ORIGIN=http://localhost:3210

# basedb 0.5.0 or later (docs/architecture/00-decisions-structurantes.md, D2 to D4).
# BASEDB_API_URL=http://localhost:8787
# BASEDB_TENANT=t4z56fq
# The « Messagerie » base, as `pnpm provision` names it, and an integration token of that
# base for the REST surface, read-only.
# BASEDB_BASE=b_t4z56fq_messagerie
# BASEDB_TOKEN=bdb_…

# `pnpm provision` only: an administrator of basedb, by token or by e-mail and password.
# BASEDB_ADMIN_TOKEN=bda_…
# BASEDB_ADMIN_EMAIL=
# BASEDB_ADMIN_PASSWORD=

# Development only: requests without a token are made as this basedb user. `dev-marc` is
# seeded by `pnpm seed`.
CHAT_DEV_AGENT=dev-marc
