# Chat server — every variable is optional in development.
# CHAT_PORT=8810
# DATABASE_URL=postgres://chat:chat@127.0.0.1:55440/chat
# CHAT_WEB_ORIGIN=http://localhost:3210
# Signs the visitors' tokens. Required in production, 32 characters at least:
#   openssl rand -base64 32
# CHAT_SECRET=
# 1 behind a reverse proxy: the visitor's address is read from X-Forwarded-For.
# CHAT_TRUST_PROXY=1
# Where the files sent in conversations are kept (10 Mo each at most).
# CHAT_FILES_DIR=.files
# GIPHY's key, for the GIFs the agents send (https://developers.giphy.com). Without it, the
# picker has emoji only. Searched through the server: the key never reaches a browser.
# GIPHY_API_KEY=

# The AI (docs/architecture/00-decisions-structurantes.md, D7, D9). Without a key, no AI:
# every conversation goes to the agents.
# CHAT_AI_PROVIDER=mistral            # or openai, ollama
# CHAT_AI_BASE_URL=                   # any OpenAI-compatible server
# CHAT_AI_MODEL=mistral-small-latest
# CHAT_AI_EMBEDDING_MODEL=mistral-embed
# CHAT_AI_API_KEY=
# CHAT_AI_REDACT=0                    # send personal data as it is (masked by default)
# CHAT_AI_MIN_SIMILARITY=0.7          # below, a passage is not a source
# CHAT_AI_SPEECH_MODEL=voxtral-mini-tts-latest   # reads messages aloud in audio mode (`off`)
# CHAT_AI_SPEECH_VOICE=fr_marie_neutral
# separate: the AI's jobs and the webhooks' calls run in `pnpm worker`, not in the server.
# CHAT_WORKER=separate

# Webhooks (D17) call HTTPS addresses on port 443 that are public, nothing else. Names,
# `*.domains` or CIDR ranges trusted even when private — an internal CRM:
# CHAT_WEBHOOK_ALLOW=crm.interne.example,10.20.0.0/16
# Development only: HTTP and private addresses allowed, to try a webhook on this machine.
# CHAT_WEBHOOK_DEV=1

# Secrets the AI's tools and MCP servers name in the settings as ${NAME} — never their
# values (D5). The demonstration needs none.
# METEO_TOKEN=

# Signing in (D19). The first supervisor is created from the sign-in screen at the first
# start. Where the server is reached from outside — an identity provider calls back there:
# CHAT_PUBLIC_URL=http://localhost:8810
# An OpenID Connect provider — Microsoft Entra, Google, Keycloak… — besides the password.
# Its redirect URI: ${CHAT_PUBLIC_URL}/api/auth/oidc/callback. It signs in the agent of the
# same e-mail: agents are invited first.
# CHAT_OIDC_ISSUER=https://login.microsoftonline.com/<tenant>/v2.0
# CHAT_OIDC_CLIENT_ID=
# CHAT_OIDC_CLIENT_SECRET=
# CHAT_OIDC_NAME=Microsoft

# Development only: the inbox's requests without a session are made as this agent — no
# sign-in on a developer's machine. The demonstration's supervisor:
CHAT_DEV_AGENT=marc.jamain@exemple.fr
