{
  "name": "@chat/server",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "db:generate": "drizzle-kit generate",
    "test:int": "vitest run test/int",
    "simulate": "tsx --env-file-if-exists=.env src/simulate.ts",
    "test:unit": "vitest run test/unit",
    "site-secret": "tsx --env-file-if-exists=.env src/site-secret.ts",
    "worker": "tsx --env-file-if-exists=.env src/worker.ts",
    "mcp-demo": "tsx src/dev/agencies-mcp.ts"
  },
  "dependencies": {
    "@chat/ai": "workspace:*",
    "@chat/widget": "workspace:*",
    "@hono/node-server": "^1.19.11",
    "@hono/node-ws": "^1.3.1",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "nodemailer": "^8",
    "openid-client": "^6",
    "pg": "^8.23.1",
    "pg-boss": "^12.35.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@chat/contracts": "workspace:*",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
