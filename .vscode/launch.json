{
  // Démarrer la messagerie depuis VS Code (Exécuter et déboguer, F5).
  //
  // « Messagerie » lance tout : PostgreSQL et basedb dans Docker (tâche préalable), le
  // serveur, l'inbox, la reconstruction du widget et le serveur MCP de démonstration — et
  // ouvre l'inbox. Chaque partie se lance aussi seule ; les points d'arrêt marchent dans le
  // serveur et dans l'inbox. Les sorties sont dans la Console de débogage, une par partie.
  //
  // Node est lancé directement, sans shell : la messagerie tourne sur le système de la
  // fenêtre VS Code, Windows pour une fenêtre Windows, quel que soit le terminal par défaut.
  // (Une fenêtre « WSL » en bas à gauche lance tout dans WSL : rouvrez le dossier sous
  // Windows — voir le README.)
  //
  // Première fois : tâches « Installer les dépendances », puis « basedb : créer la base et
  // relier la messagerie » et « Données de démonstration » (Terminal › Exécuter la tâche).
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Serveur",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/server",
      "runtimeArgs": ["--env-file-if-exists=.env", "--watch", "--import", "tsx"],
      "program": "${workspaceFolder}/apps/server/src/main.ts",
      "console": "internalConsole",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Inbox",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/web",
      "program": "${workspaceFolder}/apps/web/node_modules/next/dist/bin/next",
      "args": ["dev", "--port", "3210"],
      "console": "internalConsole",
      "outputCapture": "std",
      "skipFiles": ["<node_internals>/**"],
      "serverReadyAction": {
        "pattern": "- Local:\\s+(https?://\\S+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "Widget (reconstruction)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/widget",
      "program": "${workspaceFolder}/apps/widget/build.mjs",
      "args": ["--watch"],
      "console": "internalConsole",
      "outputCapture": "std"
    },
    {
      "name": "Serveur MCP de démo",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/apps/server",
      "runtimeArgs": ["--import", "tsx"],
      "program": "${workspaceFolder}/apps/server/src/dev/agencies-mcp.ts",
      "console": "internalConsole",
      "outputCapture": "std"
    }
  ],
  "compounds": [
    {
      "name": "Messagerie",
      "configurations": ["Serveur", "Inbox", "Widget (reconstruction)", "Serveur MCP de démo"],
      "preLaunchTask": "Docker : PostgreSQL et basedb",
      "stopAll": true
    }
  ]
}
